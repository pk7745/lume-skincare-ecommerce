# =========================================================
# LUMÉ BACKEND ENVIRONMENT CONFIGURATION (.env.example)
# =========================================================

# ---------------------------------------------------------
# REQUIRED PRODUCTION VARIABLES
# ---------------------------------------------------------
NODE_ENV=production
PORT=5000

# Primary MongoDB Database Connection URL (Atlas M0 Cluster or Standalone MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/lume?retryWrites=true&w=majority

# Allowed Storefront Origin for CORS
CLIENT_URL=http://localhost:5173

# JWT Security Secrets (Must be secure 32+ character strings in production)
ACCESS_TOKEN_SECRET=your_jwt_access_token_secret_min32chars 
REFRESH_TOKEN_SECRET=your_jwt_refresh_token_secret_min32chars

ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Payment Mode ('mock' for built-in payment, 'stripe' for live Stripe integration)
PAYMENT_MODE=mock

# Initial Seed Admin Account Credentials
SEED_ADMIN_EMAIL=admin@lumeskincare.com
SEED_ADMIN_PASSWORD=AdminPassword123!

# ---------------------------------------------------------
# OPTIONAL VARIABLES (Required ONLY if PAYMENT_MODE=stripe)
# ---------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------
# UNUSED / OPTIONAL PLACEHOLDERS
# ---------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
